# 把這個檔案複製成 .env 後，依你的環境修改
# ------------------------------------------------------------

# PostgreSQL 連線（帳號:密碼@主機:埠/資料庫名）
DATABASE_URL=postgresql+pg8000://postgres:postgres@localhost:5432/wedding

# Redis 連線（若沒裝 Redis，程式仍可正常運作，只是沒有快取加速）
REDIS_URL=redis://localhost:6379/0

# 後台登入密碼（★ 請改成你自己的）
ADMIN_PASSWORD=change-me

# 幫手密碼（招待、伴郎伴娘用）：只能看賓客名單與報到，看不到預算、合約、設定。留空 = 不啟用
HELPER_PASSWORD=

# 簽章金鑰（★ 請改成一段隨機字串，登入 token 用）
SECRET_KEY=change-me-to-a-long-random-string

# 服務埠（前後端共用同一個 port）
PORT=8000

# Telegram 通知（留空 = 不啟用）
# Bot token 向 @BotFather 申請；chat_id 為群組 ID（負數）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Gmail 寄信（後台群發通知用；留空 = 不啟用）
# SMTP_PASSWORD 是 Gmail「應用程式密碼」（Google 帳戶 → 安全性 → 兩步驟驗證 → 應用程式密碼）
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=宣文 & 孟庭

# 上傳檔案（合約、收據、婚紗照）存放目錄；留空 = backend/uploads。單檔上限 MB
UPLOAD_DIR=
MAX_UPLOAD_MB=20

